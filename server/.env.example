# Porta única do servidor — serve a API e os estáticos do front-end (dist/).
PORT=3000

# Caminho do arquivo SQLite. Opcional — por padrão usa server/data/meucfo.db.
# DB_PATH=./data/meucfo.db

# Chave da API da Anthropic, usada só pelo servidor (nunca vai ao front-end —
# ver docs/adr/0002-chave-de-api-nunca-no-front.md). Sem essa variável,
# POST /api/chat funciona no modo degradado (resposta baseada em regras,
# sem chamar o modelo).
ANTHROPIC_API_KEY=
